{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (CLI)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/PriorityTaskManager.CLI/bin/Debug/net8.0/PriorityTaskManager.CLI.dll",
            "args": [],
            "cwd": "${workspaceFolder}/PriorityTaskManager.CLI",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "API (Cloud, dev seed :5299)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build API",
            "program": "${workspaceFolder}/PriorityTaskManager.API/bin/Debug/net8.0/PriorityTaskManager.API.dll",
            "args": [],
            "cwd": "${workspaceFolder}/PriorityTaskManager.API",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "env": {
                "ASPNETCORE_URLS": "http://127.0.0.1:5299",
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "Flutter (Windows)",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder}/PriorityTaskManager.Flutter",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "windows"
            ]
        },
        {
            "name": "Flutter (Web)",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder}/PriorityTaskManager.Flutter",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "edge"
            ]
        }
    ],
    "compounds": [
        {
            "name": "API + CLI",
            "configurations": [
                "API (Cloud, dev seed :5299)",
                ".NET Core Launch (CLI)"
            ]
        },
        {
            "name": "API + Flutter (Windows)",
            "configurations": [
                "API (Cloud, dev seed :5299)",
                "Flutter (Windows)"
            ]
        }
    ]
}