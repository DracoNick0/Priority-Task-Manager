{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "API (Cloud, dev seed :5299)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build API",
            "program": "${workspaceFolder}/PriorityTaskManager.API/bin/Debug/net8.0/PriorityTaskManager.API.dll",
            "args": [],
            "cwd": "${workspaceFolder}/PriorityTaskManager.API",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "env": {
                "ASPNETCORE_URLS": "http://127.0.0.1:5299",
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "Flutter (Windows)",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder}/PriorityTaskManager.Flutter",
            "program": "lib/main.dart",
            "deviceId": "windows"
        },
        {
            "name": "Flutter (Web)",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder}/PriorityTaskManager.Flutter",
            "program": "lib/main.dart",
            "deviceId": "edge"
        },
        {
            "name": "Flutter (Windows, Fly.io prod)",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder}/PriorityTaskManager.Flutter",
            "program": "lib/main.dart",
            "deviceId": "windows",
            "toolArgs": [
                "--dart-define=API_BASE_URL=https://tpm-api.fly.dev"
            ]
        }
    ],
    "compounds": [
        {
            "name": "API + Flutter (Windows)",
            "configurations": [
                "API (Cloud, dev seed :5299)",
                "Flutter (Windows)"
            ]
        }
    ]
}